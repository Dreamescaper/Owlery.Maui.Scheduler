<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cleared so a machine-level private feed cannot satisfy a restore here. A public library must
       resolve from nuget.org and nowhere else, or a build succeeds locally and fails for everyone. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
