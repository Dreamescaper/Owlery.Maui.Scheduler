<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 carries no platform code, so the layout and geometry logic can be referenced and
         unit-tested from a plain project. iOS stays conditional: the Android CI job runs on Linux
         with only the maui-android workload installed, and this project is restored as part of
         Owlery.Mobile's build there. -->
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([System.OperatingSystem]::IsLinux())">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Owlery.Maui.Scheduler</RootNamespace>

    <!-- The control is built entirely in C#; no XAML, no Blazor. -->
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!-- The layout engine and geometry are internal on purpose; the tests assert on them directly. -->
    <InternalsVisibleTo Include="Owlery.Maui.Scheduler.Tests" />
  </ItemGroup>

</Project>
