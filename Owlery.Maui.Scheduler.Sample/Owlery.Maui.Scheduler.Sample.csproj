<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS stays conditional for the same reason the control does: the Android CI job runs on
         Linux with only the maui-android workload installed. -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([System.OperatingSystem]::IsLinux())">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Owlery.Maui.Scheduler.Sample</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>

    <!-- The playground is built entirely in C#, like the control it exercises. -->
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>

    <ApplicationTitle>Scheduler Playground</ApplicationTitle>
    <ApplicationId>com.owlery.scheduler.playground</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2F5D8A" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F5D8A" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <!-- Debug only, so nothing about the playground's tooling reaches a Release build. This is how a
       device gets driven from a terminal: the playground is the reference host for the control, and
       everything the headless suite cannot reach — gesture arbitration, platform paging, drag-and-drop
       — has to be exercised here. See README.md. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Owlery.Maui.Scheduler\Owlery.Maui.Scheduler.csproj" />
  </ItemGroup>

</Project>
